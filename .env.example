# Dementa OS settings.
# Copy this file to .env.local and change the values there. .env.local stays private (it is
# never shared or committed); this example file is safe to share.
#
# Variables starting with NEXT_PUBLIC_ are built into the web pages, so anyone using Dementa OS
# can see them. Never put a password or secret in a NEXT_PUBLIC_ variable.

# ---- Web app (read by `npm run dev` / `npm run build`) ----

# Address of the Dementa cloud (the Files app's storage), as the web pages see it.
#   Empty (recommended): same address as Dementa OS; the web server forwards /api to
#                        DEMENTA_CLOUD_URL below. Works through any link to this server.
#   After deploying you may instead use https://dementa-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_DEMENTA_API=

# Where the web server forwards /api requests when NEXT_PUBLIC_DEMENTA_API is empty.
DEMENTA_CLOUD_URL=http://localhost:8787

# ---- Local cloud test server (read by `npm run cloud:dev`) ----

# Port for the local cloud test server. Must match NEXT_PUBLIC_DEMENTA_API above.
DEMENTA_CLOUD_PORT=8787

# ---- Cloudflare / R2 (private: never prefix these with NEXT_PUBLIC_) ----
# Dementa OS itself does not need these: the Worker reaches R2 through its built-in binding
# (worker/wrangler.jsonc). They are for deploying without `wrangler login`, and for backup or
# other tools that use R2's S3-compatible API.

# Your Cloudflare account ID: dashboard → any page → right-hand sidebar "Account ID".
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# API token for deploying (wrangler). Create at dashboard → My Profile → API Tokens, using the
# "Edit Cloudflare Workers" template plus R2 edit permission. Leave empty to use
# `npx wrangler login` instead.
CLOUDFLARE_API_TOKEN=

# R2 bucket holding the files. Must match "bucket_name" in worker/wrangler.jsonc.
R2_BUCKET_NAME=dementa-os

# R2 S3-compatible access keys (for backups / external tools only).
# Create at dashboard → R2 → Manage R2 API Tokens → Create API token.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 S3 endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
